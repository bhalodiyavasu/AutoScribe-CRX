{
  "manifest_version": 3,
  "name": "AutoScribe",
  "description": "AI-powered form filler with realistic Indian data",
  "version": "2.0.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icons/icon.png",
    "default_title": "AutoScribe – AI Fill Form"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.css", "popup.html", "icons/icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
